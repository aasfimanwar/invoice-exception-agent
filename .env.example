# Copy to .env (never commit .env). Keys stay local. Synthetic data only.
GEMINI_API_KEY=
GROQ_API_KEY=

# Langfuse Cloud (Hobby). Host depends on the region of your project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Run controls (ADR-004, ADR-005, ADR-006)
LLM_MODE=replay            # replay | record | live
MODEL_PROFILE=LITE         # LITE | FULL
SYSTEM_UNDER_TEST_PROVIDER=gemini
JUDGE_PROVIDER=groq        # must differ in family from the system under test
ALLOW_FAILOVER=false       # must stay false during eval runs
TRACE_EXPORT=false         # true only for live milestone runs (Langfuse unit budget)

# Daily budget guard: fraction of the smallest daily limit one eval run may use
RUN_BUDGET_FRACTION=0.25

# Test set lock (ADR-017): leave unset. Only the final report sets this; every access is logged.
# ALLOW_TEST_SET=final
